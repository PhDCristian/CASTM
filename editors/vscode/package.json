{
  "name": "openedge-dsl",
  "displayName": "OpenEdge DSL",
  "description": "Language support for OpenEdge DSL - CGRA programming made easy",
  "version": "0.1.0",
  "publisher": "phdcristian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhDCristian/OpenEdgeDSL"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "cgra",
    "dsl",
    "hardware",
    "reconfigurable",
    "openedge"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:openedge"
  ],
  "contributes": {
    "languages": [
      {
        "id": "openedge",
        "aliases": [
          "OpenEdge DSL",
          "openedge",
          "dsl"
        ],
        "extensions": [
          ".dsl",
          ".openedge"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "openedge",
        "scopeName": "source.openedge",
        "path": "./syntaxes/openedge.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "OpenEdge DSL",
      "properties": {
        "openedge.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable diagnostics (errors and warnings)"
        },
        "openedge.completion": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable autocompletion"
        },
        "openedge.hover": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable hover information"
        },
        "openedge.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems to report per file"
        },
        "openedge.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        }
      }
    },
    "commands": [
      {
        "command": "openedge.restartServer",
        "title": "OpenEdge: Restart Language Server"
      },
      {
        "command": "openedge.compileFile",
        "title": "OpenEdge: Compile Current File"
      }
    ],
    "snippets": [
      {
        "language": "openedge",
        "path": "./snippets/openedge.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.0.0"
  }
}
