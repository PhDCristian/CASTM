{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OpenEdge DSL",
  "scopeName": "source.openedge",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#registers" },
    { "include": "#opcodes" },
    { "include": "#pe-location" },
    { "include": "#labels" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.openedge",
          "match": "//.*$"
        },
        {
          "name": "comment.block.openedge",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "meta.preprocessor.pragma.openedge",
          "match": "(#pragma)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.pragma.openedge" },
            "2": { "name": "entity.name.tag.pragma.openedge" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.openedge",
          "match": "\\.(const|alias|data|io_load|io_store|limit|assert)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.openedge",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.openedge",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.openedge",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.openedge",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.openedge",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.openedge",
          "match": "\\b(kernel|config|cycle|for|while|if|else|in|range|at|function|end|row)\\b"
        },
        {
          "name": "keyword.other.openedge",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.openedge",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.openedge",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.openedge",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.openedge",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arrow.openedge",
          "match": "->"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.openedge",
          "match": "\\b(R[0-9]|R1[0-5]|ROUT|RCL|RCR|ZERO|IMM)\\b"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "name": "entity.name.function.opcode.memory.openedge",
          "match": "\\b(LWI|SWI|LW|SW)\\b"
        },
        {
          "name": "entity.name.function.opcode.alu.openedge",
          "match": "\\b(ADD|SUB|MUL|SADD|SSUB|SMUL|AND|OR|XOR|SHL|SHR|ASR|NOT|NEG|ABS|MIN|MAX|CMP|MOV|MOVI)\\b"
        },
        {
          "name": "entity.name.function.opcode.control.openedge",
          "match": "\\b(NOP|EXIT|JMP|BEQ|BNE|BLT|BGE|BGT|BLE|CALL|RET)\\b"
        },
        {
          "name": "entity.name.function.opcode.special.openedge",
          "match": "\\b(SYNC|BARRIER|REDUCE|BCAST)\\b"
        }
      ]
    },
    "pe-location": {
      "patterns": [
        {
          "name": "meta.pe-location.openedge",
          "match": "@(\\d+),(\\d+)",
          "captures": {
            "0": { "name": "entity.name.tag.pe-location.openedge" },
            "1": { "name": "constant.numeric.row.openedge" },
            "2": { "name": "constant.numeric.col.openedge" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.openedge",
          "match": "^\\s*(\\w+)(?=:)",
          "captures": {
            "1": { "name": "entity.name.label.openedge" }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.openedge",
          "match": "\\b(function)\\s+(\\w+)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.control.openedge" },
            "2": { "name": "entity.name.function.openedge" }
          }
        },
        {
          "name": "meta.function-call.openedge",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.openedge" }
          }
        }
      ]
    }
  }
}
