{
  "Kernel": {
    "prefix": "kernel",
    "body": [
      "kernel \"${1:KernelName}\" {",
      "\tconfig(0xF, 0);",
      "\t",
      "\tcycle {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create a new kernel"
  },
  "Cycle": {
    "prefix": "cycle",
    "body": [
      "cycle {",
      "\t@${1:0},${2:0}: ${0}",
      "}"
    ],
    "description": "Create a cycle block"
  },
  "Labeled Cycle": {
    "prefix": "lcycle",
    "body": [
      "${1:label}: cycle {",
      "\t@${2:0},${3:0}: ${0}",
      "}"
    ],
    "description": "Create a labeled cycle block"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in range(${2:0}, ${3:10}) {",
      "\tcycle {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create a for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:R0} ${2|!=,==,<,>,<=,>=|} ${3:0} at @${4:0},${5:0} {",
      "\tcycle {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create a while loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:R0} ${2|==,!=,<,>,<=,>=|} ${3:0} at @${4:0},${5:0} {",
      "\tcycle {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create an if statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if ${1:R0} ${2|==,!=,<,>,<=,>=|} ${3:0} at @${4:0},${5:0} {",
      "\tcycle {",
      "\t\t${6}",
      "\t}",
      "} else {",
      "\tcycle {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create an if-else statement"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:params}) {",
      "\t${0}",
      "}"
    ],
    "description": "Create a function"
  },
  "Constant": {
    "prefix": ".const",
    "body": [".const ${1:NAME} = ${2:value}"],
    "description": "Define a constant"
  },
  "Alias": {
    "prefix": ".alias",
    "body": [".alias ${1:name} = ${2:R0}"],
    "description": "Define a register alias"
  },
  "Data Array": {
    "prefix": ".data",
    "body": [".data ${1:name} @ ${2:0x100} = [${3:values}]"],
    "description": "Define a data array"
  },
  "IO Load": {
    "prefix": ".io_load",
    "body": [".io_load = [${1:addresses}]"],
    "description": "Define I/O load addresses"
  },
  "IO Store": {
    "prefix": ".io_store",
    "body": [".io_store = [${1:addresses}]"],
    "description": "Define I/O store addresses"
  },
  "Limit": {
    "prefix": ".limit",
    "body": [".limit = ${1:1000}"],
    "description": "Set cycle limit"
  },
  "Assert": {
    "prefix": ".assert",
    "body": [".assert ${1:condition}"],
    "description": "Define an assertion"
  },
  "Pragma Unroll": {
    "prefix": "#pragma unroll",
    "body": ["#pragma unroll(${1:factor})"],
    "description": "Unroll the following loop"
  },
  "Pragma Parallel": {
    "prefix": "#pragma parallel",
    "body": ["#pragma parallel"],
    "description": "Parallelize the following loop"
  },
  "Pragma Reduce": {
    "prefix": "#pragma reduce",
    "body": ["#pragma reduce(${1|ADD,MUL,AND,OR,XOR|}, ${2:R0}, ${3:R1})"],
    "description": "Generate a reduction pattern"
  },
  "Pragma Stencil": {
    "prefix": "#pragma stencil",
    "body": ["#pragma stencil(${1|cross,box|}, ${2:ADD}, ${3:R0}, ${4:R1})"],
    "description": "Generate a stencil pattern"
  },
  "Pragma Route": {
    "prefix": "#pragma route",
    "body": ["#pragma route(@${1:0},${2:0}) -> (@${3:1},${4:1}) payload(${5:R0}) accum(${6:R1})"],
    "description": "Generate explicit data routing"
  },
  "Pragma Scan": {
    "prefix": "#pragma scan",
    "body": ["#pragma scan(${1|ADD,MUL|}, ${2:R0}, ${3:R1}, ${4|right,left,down,up|})"],
    "description": "Generate a prefix scan pattern"
  },
  "Pragma Broadcast": {
    "prefix": "#pragma broadcast",
    "body": ["#pragma broadcast(value=${1:R0}, from=@${2:0},${3:0}, to=${4|row,col,all|})"],
    "description": "Broadcast a value"
  },
  "Load Word": {
    "prefix": "lwi",
    "body": ["LWI ${1:R0}, ${2:data}[${3:0}]"],
    "description": "Load word immediate"
  },
  "Store Word": {
    "prefix": "swi",
    "body": ["SWI ${1:R0}, ${2:data}[${3:0}]"],
    "description": "Store word immediate"
  },
  "Add": {
    "prefix": "add",
    "body": ["ADD ${1:R0}, ${2:R1}, ${3:R2}"],
    "description": "Add two registers"
  },
  "Multiply": {
    "prefix": "mul",
    "body": ["MUL ${1:R0}, ${2:R1}, ${3:R2}"],
    "description": "Multiply two registers"
  },
  "PE Instruction": {
    "prefix": "@",
    "body": ["@${1:0},${2:0}: ${3:NOP};"],
    "description": "Instruction at PE location"
  },
  "Load-Compute-Store Pattern": {
    "prefix": "lcs",
    "body": [
      "// Load",
      "@${1:0},${2:0}: LWI R0, ${3:input}[0];",
      "@${1:0},${4:1}: LWI R1, ${3:input}[1];",
      "",
      "// Compute",
      "@${1:0},${2:0}: ${5:ADD} R2, R0, R1;",
      "",
      "// Store",
      "@${1:0},${2:0}: SWI R2, ${6:output}[0];"
    ],
    "description": "Load-Compute-Store pattern"
  }
}
