{
  "name": "@openedge/v2-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run -c ./vitest.config.ts",
    "test:watch": "vitest -c ./vitest.config.ts",
    "docs:generate": "npm run docs:generate --workspace @openedge/lang-spec",
    "check:boundaries": "node ./scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
