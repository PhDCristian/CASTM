target "uma-cgra-base";
let M = 0xFF;
let DATA = { 10, 20, 30, 40 };

function bump(src) {
  cycle { at @0,0: R2 = src + 1; }
}

kernel "grammar_glance" {
  for i in range(0, 4) unroll(2) {
    cycle { @i/4,i%4: R0 = DATA[i]; }
  }
  if (R0 != 0) at @0,0 {
    bump(R0);
  } else {
    cycle { at @0,0: R2 = ZERO; }
  }
  cycle { at @0,0: R3 = R2 & M; }
}
