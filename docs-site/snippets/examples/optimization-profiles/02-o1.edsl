target base;
build {
  optimize O1;
}
kernel "profile_compare_o1" {
  cycle { at @0,0: SADD R1, R0, 1; }
  cycle { at @0,1: SADD R2, R0, 2; }
  cycle { at @0,2: SADD R3, R0, 3; }
  cycle { at @0,3: SADD R0, R0, 4; }
  cycle { at @1,0: SADD R1, R1, R2; }
  cycle { at @1,1: SADD R2, R2, R3; }
  cycle { at @1,2: SADD R3, R3, R0; }
}
