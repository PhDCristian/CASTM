{
  "name": "@phdcristian/openedge-dsl",
  "version": "0.1.0",
  "description": "OpenEdge-DSL: A domain-specific language for programming Coarse-Grained Reconfigurable Arrays (CGRAs)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openedge": "./bin/openedge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node18 --outfile=dist/cli.js --format=esm --packages=external",
    "cli": "node bin/openedge.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run build:cli"
  },
  "keywords": [
    "cgra",
    "dsl",
    "compiler",
    "reconfigurable",
    "spatial-computing",
    "openedge",
    "cli"
  ],
  "author": "Cristian Campos <cristian@uma.es>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhDCristian/OpenEdgeDSL.git"
  },
  "bugs": {
    "url": "https://github.com/PhDCristian/OpenEdgeDSL/issues"
  },
  "homepage": "https://github.com/PhDCristian/OpenEdgeDSL#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.4.0",
    "commander": "^12.0.0",
    "figlet": "^1.10.0",
    "gradient-string": "^3.0.0",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "ora": "^9.1.0",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.10.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
