target base;

build {
  optimize O0;
  scheduler safe;
  scheduler_window 0;
  memory_reorder strict;
  prune_noop_cycles off;
  grid 4x4 torus;
}

kernel "internal_matrix_async" {
  cycle {
    at row 0: LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100;
    at row 1: LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100;
    at row 2: LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100;
    at row 3: LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100 | LWI R3, 4100;
  }

  // --- Optimized global sum reduction tree (16 -> 1), modular at each level ---
  // Level 1: 16 -> 8
  cycle {
    at row 0: LWI R0, 0 | LWI R0, 4 | LWI R0, 8 | LWI R0, 12;
    at row 1: LWI R0, 16 | LWI R0, 20 | LWI R0, 24 | LWI R0, 28;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: LWI R2, 32 | LWI R2, 36 | LWI R2, 40 | LWI R2, 44;
    at row 1: LWI R2, 48 | LWI R2, 52 | LWI R2, 56 | LWI R2, 60;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0;
    at row 1: SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SWI R2, 1000 | SWI R2, 1004 | SWI R2, 1008 | SWI R2, 1012;
    at row 1: SWI R2, 1016 | SWI R2, 1020 | SWI R2, 1024 | SWI R2, 1028;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }

  // Level 2: 8 -> 4
  cycle {
    at row 0: LWI R0, 1000 | LWI R0, 1004 | LWI R0, 1008 | LWI R0, 1012;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: LWI R2, 1016 | LWI R2, 1020 | LWI R2, 1024 | LWI R2, 1028;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0 | SADD R2, R2, R0;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SWI R2, 1000 | SWI R2, 1004 | SWI R2, 1008 | SWI R2, 1012;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }

  // Level 3: 4 -> 2
  cycle {
    at row 0: LWI R0, 1000 | LWI R0, 1004 | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: LWI R2, 1008 | LWI R2, 1012 | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SADD R2, R2, R0 | SADD R2, R2, R0 | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SWI R2, 1000 | SWI R2, 1004 | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }

  // Level 4: 2 -> 1
  cycle {
    at row 0: LWI R0, 1000 | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: LWI R2, 1004 | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SADD R2, R2, R0 | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }
  cycle {
    at row 0: SWI R2, 4604 | NOP | NOP | NOP;
    at row 1: NOP | NOP | NOP | NOP;
    at row 2: NOP | NOP | NOP | NOP;
    at row 3: NOP | NOP | NOP | NOP;
  }

  // Associative seed: R1 starts from global sum s
  cycle {
    at row 0: LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604;
    at row 1: LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604;
    at row 2: LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604;
    at row 3: LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604 | LWI R1, 4604;
  }
  cycle {
    at row 0: LWI R2, 0 | LWI R2, 4 | LWI R2, 8 | LWI R2, 12;
    at row 1: LWI R2, 16 | LWI R2, 20 | LWI R2, 24 | LWI R2, 28;
    at row 2: LWI R2, 32 | LWI R2, 36 | LWI R2, 40 | LWI R2, 44;
    at row 3: LWI R2, 48 | LWI R2, 52 | LWI R2, 56 | LWI R2, 60;
  }

  // Asynchronous per-lane constant multiply schedule
  cycle {
    at row 0: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 1: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R1, R1, R2;
    at row 2: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 3: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3;
    at row 2: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 3: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 2: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 3: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF;
  }
  cycle {
    at row 0: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R1, R1, R2;
    at row 1: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 2: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2;
    at row 3: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 2: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3;
    at row 3: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 2: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 3: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF;
  }
  cycle {
    at row 0: SADD R1, R1, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 1: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R1, R1, R2 | SADD R1, R1, R2;
    at row 2: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2;
    at row 3: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R1, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3;
    at row 2: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3;
    at row 3: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 2: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 3: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF;
  }
  cycle {
    at row 0: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2;
    at row 1: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 2: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 3: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 2: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 3: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 2: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 3: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
  }
  cycle {
    at row 0: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2;
    at row 1: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 2: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 3: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 2: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 3: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 2: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 3: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
  }
  cycle {
    at row 0: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2;
    at row 1: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R1, R1, R2;
    at row 2: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 3: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3;
    at row 2: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 3: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 1: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R1, R1, R0, SELF;
    at row 2: BSFA R2, R2, R0, SELF | BSFA R1, R1, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
    at row 3: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
  }
  cycle {
    at row 0: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 1: SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
    at row 2: SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R1, R1, R2;
    at row 3: SADD R2, R2, R2 | SADD R1, R1, R2 | SADD R2, R2, R2 | SADD R2, R2, R2;
  }
  cycle {
    at row 0: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 1: SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
    at row 2: SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R1, R3;
    at row 3: SSUB R0, R2, R3 | SSUB R0, R1, R3 | SSUB R0, R2, R3 | SSUB R0, R2, R3;
  }
  cycle {
    at row 0: BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF | BSFA R2, R2, R0, SELF;
