// Internal Matrix — JUMP v2 (78 compiled cycles)
// Opts: link PE @3,3, return via R0, R3 permanent prime, merged subrSumStep
target base;

build {
  optimize O0;
  scheduler safe;
  scheduler_window 0;
  memory_reorder strict;
  prune_noop_cycles off;
  grid 4x4 torus;
}

kernel "internal_matrix_jump_v2" {
  // ═══ Setup (3 cycles) ═══
  cycle { at all: LWI R3, 4100; }
  cycle {
    for k in range(16) {
      @k/4, k%4: LWI R2, k*4;
    }
  }
  cycle { at all: SADD R1, ZERO, ZERO; }

  // ═══ Parallel constant-multiply (30 iterations via JUMP) ═══
  // iter 0 (merged)
  cycle {
    @0,1: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret0;
  }

  // iter 1 (2 cycles: @3,3 active)
  ret0: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret1;
  }

  // iter 2 (merged)
  ret1: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @0,3: goto subrBarrett;
    @3,3: R0 = ZERO + ret2;
  }

  // iter 3 (merged)
  ret2: cycle {
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret3;
  }

  // iter 4 (merged)
  ret3: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,3: goto subrBarrett;
    @3,3: R0 = ZERO + ret4;
  }

  // iter 5 (merged)
  ret4: cycle {
    @0,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret5;
  }

  // iter 6 (merged)
  ret5: cycle {
    @1,2: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret6;
  }

  // iter 7 (merged)
  ret6: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @1,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret7;
  }

  // iter 8 (merged)
  ret7: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @0,2: goto subrBarrett;
    @3,3: R0 = ZERO + ret8;
  }

  // iter 9 (merged)
  ret8: cycle {
    @0,1: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret9;
  }

  // iter 10 (merged)
  ret9: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @1,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret10;
  }

  // iter 11 (2 cycles: @3,3 active)
  ret10: cycle {
    @0,0: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret11;
  }

  // iter 12 (merged)
  ret11: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret12;
  }

  // iter 13 (merged)
  ret12: cycle {
    @0,0: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret13;
  }

  // iter 14 (2 cycles: @3,3 active)
  ret13: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret14;
  }

  // iter 15 (2 cycles: @3,3 active)
  ret14: cycle {
    @0,2: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret15;
  }

  // iter 16 (2 cycles: @3,3 active)
  ret15: cycle {
    @0,0: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret16;
  }

  // iter 17 (merged)
  ret16: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @1,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret17;
  }

  // iter 18 (merged)
  ret17: cycle {
    @0,1: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret18;
  }

  // iter 19 (merged)
  ret18: cycle {
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret19;
  }

  // iter 20 (2 cycles: @3,3 active)
  ret19: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret20;
  }

  // iter 21 (2 cycles: @3,3 active)
  ret20: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @1,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret21;
  }

  // iter 22 (merged)
  ret21: cycle {
    @0,0: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret22;
  }

  // iter 23 (merged)
  ret22: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret23;
  }

  // iter 24 (merged)
  ret23: cycle {
    @0,1: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret24;
  }

  // iter 25 (2 cycles: @3,3 active)
  ret24: cycle {
    @0,0: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,1: goto subrBarrett;
    @3,3: R0 = ZERO + ret25;
  }

  // iter 26 (merged)
  ret25: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret26;
  }

  // iter 27 (merged)
  ret26: cycle {
    @0,0: SADD R1, R1, R2;
    @0,1: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @0,2: goto subrBarrett;
    @3,3: R0 = ZERO + ret27;
  }

  // iter 28 (2 cycles: @3,3 active)
  ret27: cycle {
    @0,2: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle {
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + ret28;
  }

  // iter 29 (merged)
  ret28: cycle {
    @0,1: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett;
    @3,3: R0 = ZERO + retLast;
  }

  // ═══ Last accumulation + R1 Barrett (3 cycles) ═══
  retLast: cycle {
    @0,1: SADD R1, R1, R2;
    @0,2: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
    @0,0: LWI R2, 0;
  }
  cycle { at all: SSUB R0, R1, R3; }
  cycle { at all: BSFA R1, R1, R0, SELF; }

  // ═══ Serial global sum (@0,0) via JUMP (16 cycles) ═══
  cycle {
    @0,0: LWI R0, 4;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr1;
  }
  sr1: cycle {
    @0,0: LWI R0, 8;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr2;
  }
  sr2: cycle {
    @0,0: LWI R0, 12;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr3;
  }
  sr3: cycle {
    @0,0: LWI R0, 16;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr4;
  }
  sr4: cycle {
    @0,0: LWI R0, 20;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr5;
  }
  sr5: cycle {
    @0,0: LWI R0, 24;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr6;
  }
  sr6: cycle {
    @0,0: LWI R0, 28;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr7;
  }
  sr7: cycle {
    @0,0: LWI R0, 32;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr8;
  }
  sr8: cycle {
    @0,0: LWI R0, 36;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr9;
  }
  sr9: cycle {
    @0,0: LWI R0, 40;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr10;
  }
  sr10: cycle {
    @0,0: LWI R0, 44;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr11;
  }
  sr11: cycle {
    @0,0: LWI R0, 48;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr12;
  }
  sr12: cycle {
    @0,0: LWI R0, 52;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr13;
  }
  sr13: cycle {
    @0,0: LWI R0, 56;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + sr14;
  }
  sr14: cycle {
    @0,0: LWI R0, 60;
    @0,1: goto subrSumStep;
    @3,3: R0 = ZERO + srDone;
  }
  srDone: cycle { @0,0: SWI R2, 4604; }

  // ═══ Broadcast sum + final addition + Barrett (4 cycles) ═══
  cycle { at all: LWI R2, 4604; }
  cycle { at all: SADD R1, R1, R2; }
  cycle { at all: SSUB R0, R1, R3; }
  cycle { at all: BSFA R1, R1, R0, SELF; }

  // ═══ Store and exit (2 cycles) ═══
  cycle {
    for k in range(16) {
      @k/4, k%4: SWI R1, k*4;
    }
  }
  cycle { @0,0: EXIT; }

  // ═══════════════════════════════════════════════
  // SUBROUTINE: Barrett reduction on R1 and R2 (8 cycles)
  // R3 stays permanently 4100. Return via R0 at @3,3.
  // ═══════════════════════════════════════════════
  subrBarrett: cycle { @3,3: SWI R0, 4200; }
  cycle { at all: SSUB R0, R1, R3; }
  cycle { at all: BSFA R1, R1, R0, SELF; }
  cycle { at all: SADD R2, R2, R2; }
  cycle { at all: SSUB R0, R2, R3; }
  cycle { at all: BSFA R2, R2, R0, SELF; }
  cycle { @3,3: LWI R0, 4200; }
  cycle { @3,3: goto R0; }

  // ═══════════════════════════════════════════════
  // SUBROUTINE: Serial sum step at @0,0 (3 cycles)
  // BSFA(@0,0) + goto(@3,3) merged in last cycle
  // ═══════════════════════════════════════════════
  subrSumStep: cycle { @0,0: SADD R2, R2, R0; }
  cycle { @0,0: SSUB R0, R2, R3; }
  cycle {
    @0,0: BSFA R2, R2, R0, SELF;
    @3,3: goto R0;
  }
}
