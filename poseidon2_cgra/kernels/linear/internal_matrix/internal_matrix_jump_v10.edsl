// Internal Matrix — JUMP v10 (49 compiled)
// Torus Folding: SADD RCL,RCR / RCT,RCB eliminates relay slots
// Key insight: JUMP does not clobber ROUT, so neighbors can read
// Barrett-reduced R1 via RCL/RCR after subrReduce_entry return.
target base;
build {
  optimize O0;
  scheduler safe;
  scheduler_window 0;
  memory_reorder strict;
  prune_noop_cycles off;
  grid 4x4 torus;
}
kernel "internal_matrix_jump_v10" {
  // ═══ Setup (2) ═══
  cycle { at all: LWI R3, 4100; }
  cycle {
    for k in range(16) {
      @k/4, k%4: LWI R2, k*4;
    }
  }

  // ═══ Prefix Sum (8 cycles) — Torus Folding ═══
  // Level 1: horizontal pairs (dist 1)
  cycle { at all: SADD R1, R2, RCR; }
  cycle { @0,0: R0 = ZERO + lvl2; @0,1: goto subrReduce_entry; }

  // Level 2: horizontal FOLD (dist 2 → full row in 1 step)
  // RCL = left.ROUT = Barrett(pair_left), RCR = right.ROUT = Barrett(pair_right)
  // In 4-torus: left_pair ∪ right_pair = all 4 elements (no overlap)
  lvl2: cycle { at all: SADD R1, RCL, RCR; }
  cycle { @0,0: R0 = ZERO + lvl3; @0,1: goto subrReduce_entry; }

  // Level 3: vertical pairs (dist 1)
  lvl3: cycle { at all: SADD R1, R1, RCB; }
  cycle { @0,0: R0 = ZERO + lvl4; @0,1: goto subrReduce_entry; }

  // Level 4: vertical FOLD (dist 2 → full grid in 1 step)
  // RCT = top.ROUT = Barrett(vert_pair_top), RCB = bottom.ROUT = Barrett(vert_pair_bot)
  lvl4: cycle { at all: SADD R1, RCT, RCB; }
  cycle { @0,0: R0 = ZERO + iter0; @0,1: goto subrReduce_entry; }

  // ═══ Main Loop (30 iterations) — identical to v9 ═══
  iter0: cycle { @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @0,0: R0 = ZERO + ret0; @0,2: goto subrBarrett; }
  ret0: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,0: R0 = ZERO + ret1; @0,0: SADD R0, ZERO, ZERO; @1,1: goto subrBarrett; }
  ret1: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @1,0: R0 = ZERO + ret2; @0,3: goto subrBarrett; }
  ret2: cycle { @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @1,0: R0 = ZERO + ret3; @0,0: goto subrBarrett; }
  ret3: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @0,3: R0 = ZERO + ret4; @1,0: SADD R0, ZERO, ZERO; @1,1: goto subrBarrett; }
  ret4: cycle { @0,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @0,0: R0 = ZERO + ret5; @0,3: SADD R0, ZERO, ZERO; @0,2: goto subrBarrett; }
  ret5: cycle { @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @1,0: R0 = ZERO + ret6; @0,0: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret6: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @1,0: R0 = ZERO + ret7; @1,2: goto subrBarrett; }
  ret7: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @0,2: R0 = ZERO + ret8; @1,0: SADD R0, ZERO, ZERO; @1,1: goto subrBarrett; }
  ret8: cycle { @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @1,1: R0 = ZERO + ret9; @0,2: SADD R0, ZERO, ZERO; @0,0: goto subrBarrett; }
  ret9: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @1,0: R0 = ZERO + ret10; @1,1: SADD R0, ZERO, ZERO; @1,2: goto subrBarrett; }
  ret10: cycle { @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,2: R0 = ZERO + ret11; @1,0: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret11: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @2,1: R0 = ZERO + ret12; @1,2: SADD R0, ZERO, ZERO; @0,0: goto subrBarrett; }
  ret12: cycle { @0,0: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @1,1: R0 = ZERO + ret13; @2,1: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret13: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @0,0: R0 = ZERO + ret14; @1,1: SADD R0, ZERO, ZERO; @0,3: goto subrBarrett; }
  ret14: cycle { @0,2: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @0,1: R0 = ZERO + ret15; @0,0: SADD R0, ZERO, ZERO; @0,3: goto subrBarrett; }
  ret15: cycle { @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,0: R0 = ZERO + ret16; @0,1: SADD R0, ZERO, ZERO; @1,3: goto subrBarrett; }
  ret16: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @2,1: R0 = ZERO + ret17; @1,0: SADD R0, ZERO, ZERO; @1,3: goto subrBarrett; }
  ret17: cycle { @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @0,0: R0 = ZERO + ret18; @2,1: SADD R0, ZERO, ZERO; @0,2: goto subrBarrett; }
  ret18: cycle { @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @0,0: R0 = ZERO + ret19; @0,1: goto subrBarrett; }
  ret19: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,1: R0 = ZERO + ret20; @0,0: SADD R0, ZERO, ZERO; @0,3: goto subrBarrett; }
  ret20: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,1: R0 = ZERO + ret21; @1,3: goto subrBarrett; }
  ret21: cycle { @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @0,3: R0 = ZERO + ret22; @1,1: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret22: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @0,0: R0 = ZERO + ret23; @0,3: SADD R0, ZERO, ZERO; @1,0: goto subrBarrett; }
  ret23: cycle { @0,1: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @1,1: R0 = ZERO + ret24; @0,0: SADD R0, ZERO, ZERO; @0,2: goto subrBarrett; }
  ret24: cycle { @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @2,1: R0 = ZERO + ret25; @1,1: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret25: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @1,0: R0 = ZERO + ret26; @2,1: SADD R0, ZERO, ZERO; @0,0: goto subrBarrett; }
  ret26: cycle { @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @0,3: R0 = ZERO + ret27; @1,0: SADD R0, ZERO, ZERO; @0,2: goto subrBarrett; }
  ret27: cycle { @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @0,0: R0 = ZERO + ret28; @0,3: SADD R0, ZERO, ZERO; @0,1: goto subrBarrett; }
  ret28: cycle { @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @0,0: R0 = ZERO + retLast; @0,2: goto subrBarrett; }

  // ═══ Tail (1) — aliased to subrReduce_entry ═══
  retLast: cycle { @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2; @1,0: R0 = ZERO + end_store; @0,0: SADD R0, ZERO, ZERO; @0,3: goto subrReduce_entry; }

  // ═══ Store + Exit (2) ═══
  end_store: cycle {
    for k in range(16) {
      @k/4, k%4: SWI R1, k*4;
    }
  }
  cycle { @0,0: EXIT; }

  // ═══ Shared Subroutine (6) ═══
  subrBarrett: cycle { at all: SADD R2, R2, R2; }
  cycle { at all: SSUB ROUT, R2, R3; }
  cycle { at all: BSFA R2, R2, SELF, SELF; }
  subrReduce_entry: cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }
  cycle { at all: goto R0; }
}
