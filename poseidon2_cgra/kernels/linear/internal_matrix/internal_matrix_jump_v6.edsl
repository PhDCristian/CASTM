// Internal Matrix — JUMP v6 (shared Barrett, -ROUT=R2)
// Opts: ROUT-Bypass Barrett, Torus Ring Sum, Shared Subroutine, Dual Exit

target base;

build {
  optimize O0;
  scheduler safe;
  scheduler_window 0;
  memory_reorder strict;
  prune_noop_cycles off;
  grid 4x4 torus;
}

kernel "internal_matrix_jump_v6" {
  // ═══ Setup (2 cycles) ═══
  cycle { at all: LWI R3, 4100; }
  cycle {
    for k in range(16) {
      @k/4, k%4: LWI R2, k*4;
    }
  }

  // ═══ PARALLEL GLOBAL RING REDUCTION (14 cycles) ═══
  // LWI already sets pe.out, so ROUT=R2 is implicit.

  // Level 1: Row sum, distance 1
  cycle { at all: SADD R1, R2, RCR; }
  cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }

  // Level 2: Row sum, distance 2
  cycle { at all: SADD ROUT, RCR, ZERO; }
  cycle { at all: SADD R1, R1, RCR; }
  cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }

  // Level 3: Column sum, distance 1
  cycle { at all: SADD R1, R1, RCB; }
  cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }

  // Level 4: Column sum, distance 2
  cycle { at all: SADD ROUT, RCB, ZERO; }
  cycle { at all: SADD R1, R1, RCB; }
  cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }

  // ═══ PARALLEL CONSTANT-MULTIPLY ═══

  // iter 0: link @3,3, @1,1 free → clear
  cycle {
    @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret0; @1,1: SADD R0, ZERO, ZERO;
  }

  // iter 1: link @1,1, old @3,3 BUSY → SPLIT
  ret0: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @1,1: R0 = ZERO + ret1; @3,3: SADD R0, ZERO, ZERO; }

  // iter 2: link @3,3, old @1,1 BUSY → SPLIT
  ret1: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
  }
  cycle { @0,3: goto subrBarrett; @3,3: R0 = ZERO + ret2; @1,1: SADD R0, ZERO, ZERO; }

  // iter 3: link @3,3, same as prev → @1,1 already cleared
  ret2: cycle {
    @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret3;
  }

  // iter 4: link @3,3, same → no need to clear (prev cleared @1,1)
  ret3: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @0,3: goto subrBarrett; @3,3: R0 = ZERO + ret4;
  }

  // iter 5: link @3,3, same
  ret4: cycle {
    @0,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,0: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret5;
  }

  // iter 6: link @3,3, same
  ret5: cycle {
    @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret6;
  }

  // iter 7: link @3,3, same
  ret6: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @1,0: goto subrBarrett; @3,3: R0 = ZERO + ret7;
  }

  // iter 8: link @3,3, same
  ret7: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2;
    @0,2: goto subrBarrett; @3,3: R0 = ZERO + ret8;
  }

  // iter 9: link @3,3, same
  ret8: cycle {
    @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret9;
  }

  // iter 10: link @1,1, old @3,3 NOT busy → clear
  ret9: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @1,0: goto subrBarrett; @1,1: R0 = ZERO + ret10; @3,3: SADD R0, ZERO, ZERO;
  }

  // iter 11: link @1,1, same
  ret10: cycle {
    @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @2,1: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
    @0,1: goto subrBarrett; @1,1: R0 = ZERO + ret11;
  }

  // iter 12: link @3,3, old @1,1 BUSY → SPLIT
  ret11: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,0: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @2,0: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret12; @1,1: SADD R0, ZERO, ZERO; }

  // iter 13: link @3,3, same → prev cleared
  ret12: cycle {
    @0,0: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @0,1: goto subrBarrett; @3,3: R0 = ZERO + ret13;
  }

  // iter 14: link @1,1, old @3,3 BUSY → SPLIT
  ret13: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @1,1: R0 = ZERO + ret14; @3,3: SADD R0, ZERO, ZERO; }

  // iter 15: link @1,1, same → prev cleared
  ret14: cycle {
    @0,2: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2;
    @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @1,1: R0 = ZERO + ret15;
  }

  // iter 16: BOTH busy → already split; clear @1,1 in jump cycle
  ret15: cycle {
    @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,0: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle { @0,1: goto subrBarrett; @3,3: R0 = ZERO + ret16; @1,1: SADD R0, ZERO, ZERO; }

  // iter 17: link @3,3, same → prev cleared
  ret16: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2; @1,1: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @1,0: goto subrBarrett; @3,3: R0 = ZERO + ret17;
  }

  // iter 18: link @3,3, same
  ret17: cycle {
    @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret18;
  }

  // iter 19: link @3,3, same
  ret18: cycle {
    @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @3,0: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret19;
  }

  // iter 20: link @1,1, old @3,3 BUSY → SPLIT
  ret19: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @1,1: R0 = ZERO + ret20; @3,3: SADD R0, ZERO, ZERO; }

  // iter 21: link @1,1, same → prev cleared
  ret20: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2;
    @0,3: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @3,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
    @1,3: goto subrBarrett; @1,1: R0 = ZERO + ret21;
  }

  // iter 22: link @3,3, old @1,1 NOT busy → clear
  ret21: cycle {
    @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,3: SADD R1, R1, R2;
    @3,1: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
    @0,1: goto subrBarrett; @3,3: R0 = ZERO + ret22; @1,1: SADD R0, ZERO, ZERO;
  }

  // iter 23: link @3,3, same → prev cleared
  ret22: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,2: SADD R1, R1, R2;
    @1,3: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret23;
  }

  // iter 24: link @3,3, same
  ret23: cycle {
    @0,1: SADD R1, R1, R2; @0,3: SADD R1, R1, R2; @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,1: SADD R1, R1, R2;
    @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2; @3,1: SADD R1, R1, R2;
    @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret24;
  }

  // iter 25: link @1,1, old @3,3 BUSY → SPLIT
  ret24: cycle {
    @0,0: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @2,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
    @3,3: SADD R1, R1, R2;
  }
  cycle { @0,1: goto subrBarrett; @1,1: R0 = ZERO + ret25; @3,3: SADD R0, ZERO, ZERO; }

  // iter 26: link @3,3, old @1,1 BUSY → SPLIT
  ret25: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @0,3: SADD R1, R1, R2;
    @1,1: SADD R1, R1, R2; @1,3: SADD R1, R1, R2; @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret26; @1,1: SADD R0, ZERO, ZERO; }

  // iter 27: link @3,3, same → prev cleared
  ret26: cycle {
    @0,0: SADD R1, R1, R2; @0,1: SADD R1, R1, R2; @1,1: SADD R1, R1, R2;
    @1,2: SADD R1, R1, R2; @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2;
    @0,2: goto subrBarrett; @3,3: R0 = ZERO + ret27;
  }

  // iter 28: BOTH busy → already split; clear @1,1 in jump cycle
  ret27: cycle {
    @0,2: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,1: SADD R1, R1, R2;
    @2,0: SADD R1, R1, R2; @3,0: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
  }
  cycle { @0,0: goto subrBarrett; @3,3: R0 = ZERO + ret28; @1,1: SADD R0, ZERO, ZERO; }

  // iter 29: link @3,3, same → prev cleared
  ret28: cycle {
    @0,1: SADD R1, R1, R2; @1,0: SADD R1, R1, R2; @1,3: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @2,3: SADD R1, R1, R2;
    @3,0: SADD R1, R1, R2; @3,2: SADD R1, R1, R2;
    @0,0: goto subrBarrett; @3,3: R0 = ZERO + retLast;
  }

  // ═══ Last accumulation + inline Barrett (3 cycles) ═══
  retLast: cycle {
    @0,1: SADD R1, R1, R2; @0,2: SADD R1, R1, R2; @1,1: SADD R1, R1, R2;
    @2,1: SADD R1, R1, R2; @2,2: SADD R1, R1, R2; @3,3: SADD R1, R1, R2;
  }
  cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }

  // ═══ Store and exit (2 cycles) ═══
  cycle {
    for k in range(16) {
      @k/4, k%4: SWI R1, k*4;
    }
  }
  cycle { @0,0: EXIT; }

  // ═══ SHARED SUBROUTINE: Barrett + Dual Exit (6 cycles) ═══
  subrBarrett: cycle { at all: SSUB ROUT, R1, R3; }
  cycle { at all: BSFA R1, R1, SELF, SELF; }
  cycle { at all: SADD R2, R2, R2; }
  cycle { at all: SSUB ROUT, R2, R3; }
  cycle { at all: BSFA R2, R2, SELF, SELF; }
  cycle { @1,1: goto R0; @3,3: goto R0; }
}
